{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflict-operations.local/schemas/modset-lock.schema.json",
  "title": "COAPI Modset Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lockId",
    "generatedAt",
    "kind",
    "gameBuild",
    "mods",
    "graphSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "lockId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "DIRECT",
        "EFFECTIVE"
      ]
    },
    "gameBuild": {
      "type": "string",
      "minLength": 1
    },
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "modId",
          "name",
          "version",
          "required",
          "classification",
          "directDependencies",
          "scriptBearing",
          "approval"
        ],
        "properties": {
          "modId": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{16}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "classification": {
            "enum": [
              "PROFILE_ONLY",
              "API_OPTIONAL_DISCOVERY",
              "API_HARD_INTEGRATION",
              "DEV_ONLY"
            ]
          },
          "directDependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{16}$"
            },
            "uniqueItems": true
          },
          "scriptBearing": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "clientRequired": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "sourceRepository": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "packageIdentity": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadataObservedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approval": {
            "enum": [
              "CANDIDATE",
              "APPROVED",
              "REJECTED",
              "RETIRED"
            ]
          }
        }
      }
    },
    "graphSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scriptGraphSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceServerConfigSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
