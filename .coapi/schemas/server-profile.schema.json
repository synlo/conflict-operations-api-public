{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflict-operations.local/schemas/server-profile.schema.json",
  "title": "COAPI Canonical Server Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "gameBuild",
    "scenarioId",
    "managedJsonPointers",
    "preserveUnmanagedFields",
    "secretsSource",
    "mods",
    "renderPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "gameBuild": {
      "type": "string",
      "minLength": 1
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1
    },
    "managedJsonPointers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/"
      },
      "uniqueItems": true
    },
    "preserveUnmanagedFields": {
      "const": true
    },
    "secretsSource": {
      "const": "EXTERNAL_AT_RENDER_TIME"
    },
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "modId",
          "name",
          "version",
          "required",
          "classification",
          "certificationSha256"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "modId": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{16}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "classification": {
            "enum": [
              "PROFILE_ONLY",
              "API_OPTIONAL_DISCOVERY",
              "API_HARD_INTEGRATION"
            ]
          },
          "certificationSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "renderPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic",
        "requireExactVersions",
        "structuralMerge",
        "atomicPromotionPreferred"
      ],
      "properties": {
        "deterministic": {
          "const": true
        },
        "requireExactVersions": {
          "const": true
        },
        "structuralMerge": {
          "const": true
        },
        "atomicPromotionPreferred": {
          "const": true
        }
      }
    }
  }
}
