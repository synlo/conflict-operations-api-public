{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflict-operations.local/schemas/operation-ledger-entry.schema.json",
  "title": "COAPI Operation Ledger Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ledgerId",
    "sequence",
    "timestamp",
    "taskId",
    "mode",
    "phase",
    "operationKind",
    "normalizedCommandSha256",
    "inputSetSha256",
    "previousEntrySha256",
    "outcome",
    "artifactHashes",
    "entrySha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "ledgerId": {
      "type": "string",
      "minLength": 8
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "RECOVERY",
        "DEVELOPMENT",
        "RELEASE"
      ]
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "hypothesisId": {
      "type": [
        "string",
        "null"
      ]
    },
    "operationKind": {
      "type": "string",
      "minLength": 1
    },
    "normalizedCommandSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputSetSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previousEntrySha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "budgetName": {
      "type": [
        "string",
        "null"
      ]
    },
    "budgetBefore": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "budgetAfter": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "outcome": {
      "enum": [
        "STARTED",
        "SUCCEEDED",
        "FAILED",
        "REJECTED",
        "TIMED_OUT",
        "CANCELLED"
      ]
    },
    "exitCode": {
      "type": [
        "integer",
        "null"
      ]
    },
    "progressType": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifactHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "entrySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
