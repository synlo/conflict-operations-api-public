{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflict-operations.local/schemas/provider-certification.schema.json",
  "title": "COAPI Provider Certification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "certificationId",
    "candidateId",
    "observedAt",
    "modId",
    "version",
    "packageSha256",
    "dependencyGraphSha256",
    "scriptBearing",
    "conflictDomains",
    "provenance",
    "tests",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "certificationId": {
      "type": "string",
      "minLength": 8
    },
    "candidateId": {
      "type": "string",
      "minLength": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "modId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{16}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "packageSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependencyGraphSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scriptBearing": {
      "type": "boolean"
    },
    "clientRequired": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "conflictDomains": {
      "type": "array",
      "items": {
        "enum": [
          "CAMERA",
          "INPUT",
          "ANIMATION",
          "PLAYER_CONTROLLER",
          "GAME_MODE",
          "MISSION_HEADER",
          "FACTION_MANAGER",
          "CATALOG_SUPPLY",
          "REPLICATION_RPC",
          "UI_HUD",
          "AUDIO",
          "RESOURCE_OVERRIDE",
          "UNKNOWN"
        ]
      },
      "uniqueItems": true
    },
    "logicalResourceCollisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scriptOverrideCollisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadataSource",
        "sourceRepository",
        "sourceCommit",
        "license",
        "metadataAdvisory"
      ],
      "properties": {
        "metadataSource": {
          "type": "string",
          "minLength": 1
        },
        "sourceRepository": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceCommit": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadataAdvisory": {
          "const": true
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "decision": {
      "enum": [
        "APPROVED",
        "REJECTED",
        "BLOCKED",
        "EXPIRED"
      ]
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
