{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conflict-operations.local/schemas/mod-catalog.schema.json",
  "title": "COAPI Mod Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "mods"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mod"
      }
    }
  },
  "$defs": {
    "mod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modId",
        "name",
        "version",
        "required",
        "classification",
        "directDependencies",
        "scriptBearing",
        "approval"
      ],
      "properties": {
        "modId": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{16}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "classification": {
          "enum": [
            "PROFILE_ONLY",
            "API_OPTIONAL_DISCOVERY",
            "API_HARD_INTEGRATION",
            "DEV_ONLY"
          ]
        },
        "directDependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{16}$"
          },
          "uniqueItems": true
        },
        "effectiveDependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{16}$"
          },
          "uniqueItems": true
        },
        "scriptBearing": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "clientRequired": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sourceRepository": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceCommit": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "packageIdentity": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadataObservedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval": {
          "enum": [
            "CANDIDATE",
            "APPROVED",
            "REJECTED",
            "RETIRED"
          ]
        },
        "conflictDomains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "certificationSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "quarantineState": {
          "enum": [
            "NONE",
            "QUARANTINED",
            "CERTIFIED",
            "REJECTED",
            "EXPIRED"
          ]
        },
        "dependencyLockSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
